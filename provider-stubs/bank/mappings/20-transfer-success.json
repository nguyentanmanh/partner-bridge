{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/bank/v1/transfers",
    "headers": { "X-Bank-Api-Key": { "equalTo": "bank-local-key" } },
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.clientReference =~ /.*SUCCESS.*/ && @.amount > 0)]" }
    ]
  },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "transactionId": "BANK-TXN-001", "transactionStatus": "COMPLETED" }
  }
}
