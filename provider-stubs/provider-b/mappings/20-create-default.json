{
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/api/payment/create",
    "headers": {
      "X-Client-Id": { "equalTo": "provider-b-local-client" },
      "X-Signature": { "matches": "^[A-Za-z0-9._~+/=-]+$" },
      "Content-Type": { "contains": "application/json" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.request.orderRef =~ /.+/ && @.request.money.amount =~ /^[0-9]+(?:\\.[0-9]+)?$/ && @.request.money.currencyCode =~ /^[A-Z]{3}$/ && @.request.content =~ /.+/)]" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "responseCode": "00",
      "responseMessage": "Success",
      "data": {
        "referenceNo": "PB-REF-DEFAULT",
        "status": "P",
        "amount": "100000",
        "currencyCode": "VND"
      }
    }
  }
}
