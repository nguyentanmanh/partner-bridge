{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/api/payment/(?:create|query)",
    "headers": {
      "X-Client-Id": { "equalTo": "provider-b-local-client" },
      "X-Signature": { "absent": true }
    }
  },
  "response": {
    "status": 401,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "error": "UNAUTHORIZED", "errorDescription": "Missing signature" }
  }
}
