{
  "priority": 1,
  "request": {
    "method": "ANY",
    "urlPathPattern": "/v1/payments(?:/.*)?",
    "headers": { "X-Api-Key": { "absent": true } }
  },
  "response": {
    "status": 401,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "code": "UNAUTHORIZED", "message": "Missing API key" }
  }
}
