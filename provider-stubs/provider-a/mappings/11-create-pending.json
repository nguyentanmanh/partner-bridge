{
  "priority": 2,
  "request": {
    "method": "POST",
    "urlPath": "/v1/payments",
    "headers": {
      "X-Api-Key": { "equalTo": "provider-a-local-key" },
      "Content-Type": { "contains": "application/json" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.merchantRef =~ /.*PENDING.*/ && @.amount > 0 && @.currency =~ /^[A-Z]{3}$/ && @.note =~ /.+/)]" }
    ]
  },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "code": "SUCCESS",
      "message": "Payment created",
      "transactionId": "PA-TXN-PENDING",
      "paymentStatus": "PROCESSING",
      "amount": 100000,
      "currency": "VND"
    }
  }
}
